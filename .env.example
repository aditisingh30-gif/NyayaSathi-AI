# ===================================================================
# NyayaSathi - Environment Configuration Template
# ===================================================================
# Copy this file to .env in your backend directory or set these variables
# in your cloud deployment environment (e.g. Render Dashboard).
# DO NOT COMMIT ACTUAL API KEYS OR PASSWORDS TO SOURCE CONTROL.

# Server Settings
PORT=8000
DEBUG=False

# Google Gemini API Configuration (Server-Side Only)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=data/chromadb
CHROMA_COLLECTION_NAME=nyayasathi_legal_corpus
